# Copy to .env and fill in. Never commit .env.

# Which LLM answers questions: azure | anthropic | ollama
LLM_BACKEND=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Which model turns text into vectors: local (bge-m3) | azure (text-embedding-3-large)
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Second-stage reranker (cross-encoder); set false for the "reranker off" experiment
RERANKER_ENABLED=true

# HTTP Basic auth for the API; both empty = no auth (local development only)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Matches docker-compose.yml
DATABASE_URL=postgresql+psycopg://docmind:docmind@localhost:5432/docmind

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
